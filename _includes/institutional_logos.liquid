<style>
  .institutional-logos {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2.5rem;
    margin: 1.5rem 0 1rem;
    flex-wrap: wrap;
  }
  .institutional-logos a {
    display: inline-flex;
    align-items: center;
  }
  .institutional-logos a img {
    height: 48px;
    width: auto;
    opacity: 0.85;
    transition: opacity 0.2s ease-in-out;
  }
  .institutional-logos a:hover img {
    opacity: 1;
  }
  .institutional-logos .logo-dark { display: none; }
  html[data-theme="dark"] .institutional-logos .logo-light { display: none; }
  html[data-theme="dark"] .institutional-logos .logo-dark { display: inline-block; }
</style>

<div class="institutional-logos">
  <a href="https://www.udc.es/" target="_blank" rel="noopener" aria-label="Universidade da Coruña">
    <img class="logo-light" src="{{ '/assets/img/institutional/udc_color.svg' | relative_url }}" alt="Universidade da Coruña">
    <img class="logo-dark" src="{{ '/assets/img/institutional/udc_white.svg' | relative_url }}" alt="Universidade da Coruña">
  </a>
  <a href="https://citic.udc.es/" target="_blank" rel="noopener" aria-label="CITIC">
    <img class="logo-light" src="{{ '/assets/img/institutional/citic_color.svg' | relative_url }}" alt="CITIC">
    <img class="logo-dark" src="{{ '/assets/img/institutional/citic_white.svg' | relative_url }}" alt="CITIC">
  </a>
</div>
